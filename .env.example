# Token pessoal do ClickUp: ClickUp > Configurações (avatar) > Apps > API Token (começa com pk_)
CLICKUP_TOKEN=pk_...

# Lista do cronograma
CLICKUP_LIST_ID=901329151000

# Porta do servidor Node (API + site)
PORT=3001

# Tempo (segundos) que o servidor guarda a leitura do ClickUp antes de consultar de novo
CACHE_SECONDS=60

# Opcional: senha de edição por variável. O normal é definir com `npm run senha`
# (fica embutida no projeto, em server/src/acesso.json). Se preencher aqui, esta vale no lugar.
SENHA_EDICAO=
